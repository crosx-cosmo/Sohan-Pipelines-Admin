# SOHAN PIPELINES Admin Panel
# Configure in hosting environment settings; never commit real secret values.
# Cloudflare Dashboard > Turnstile > widget: allow the preview and production hostnames.
# Both variables are runtime/server variables (also add them in Vercel).
# The public site key is intentionally returned to the browser by the login configuration function.
TURNSTILE_SITE_KEY=
# Private key: NEVER prefix with VITE_ or expose in browser code.
TURNSTILE_SECRET_KEY=
