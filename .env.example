# SOHAN PIPELINES Admin Panel — example configuration
# This build is FRONTEND ONLY. Nothing here is required to run the app today;
# these keys exist so a real backend can be wired in later without refactoring.

# Base URL of the future REST/GraphQL API
VITE_API_BASE_URL=https://api.sohanpipelines.in/v1

# Publishable client key (never put secret keys in VITE_* variables)
VITE_API_PUBLISHABLE_KEY=pk_live_replace_me

# Feature flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_COMMAND_PALETTE=true

# Branding / support
VITE_SUPPORT_EMAIL=support@sohanpipelines.in
VITE_SUPPORT_PHONE=1800 419 7788

# Analytics (optional)
VITE_ANALYTICS_ID=
